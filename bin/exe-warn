#!/usr/bin/env python3
import tkinter as tk
import locale

# --- Traduções ---
translations = {
    "pt": {
        "title": "Aviso",
        "message": "Você está tentando executar um aplicativo do Windows (.exe).\n\nPedimos que procure por uma versão Linux ou execute usando Wine.",
        "ok": "Entendi"
    },
    "en": {
        "title": "Warning",
        "message": "You are trying to run a Windows (.exe) application.\n\nPlease look for a Linux version or run it using Wine.",
        "ok": "Got it"
    }
}

# Detectar idioma do sistema
system_lang, _ = locale.getlocale()
if system_lang is None:
    system_lang = "en"

lang_code = system_lang.split("_")[0].lower()
if lang_code not in translations:
    lang_code = "en"

# --- Criar janela ---
root = tk.Tk()
root.title(translations[lang_code]["title"])

# Tamanho e centralização
window_width = 600
window_height = 250
screen_width = root.winfo_screenwidth()
screen_height = root.winfo_screenheight()
x_cordinate = int((screen_width/2) - (window_width/2))
y_cordinate = int((screen_height/2) - (window_height/2))
root.geometry(f"{window_width}x{window_height}+{x_cordinate}+{y_cordinate}")
root.resizable(False, False)

# Fundo estilo "warning"
root.configure(bg="#fffbea")  # amarelo bem suave

# Moldura principal
frame = tk.Frame(root, bg="#fffbea")
frame.pack(expand=True, fill="both", padx=20, pady=20)

# Ícone ⚠️ grande
icon_label = tk.Label(frame, text="⚠️", font=("Segoe UI Emoji", 56), bg="#fffbea")
icon_label.pack(side="left", padx=15)

# Texto
msg = translations[lang_code]["message"]
text_label = tk.Label(
    frame,
    text=msg,
    wraplength=420,
    justify="left",
    font=("Arial", 13),
    bg="#fffbea",
    fg="#333"
)
text_label.pack(side="left", padx=10)

# Botão com estilo
btn = tk.Button(
    root,
    text=translations[lang_code]["ok"],
    command=root.destroy,
    font=("Arial", 11, "bold"),
    bg="#f0ad4e",
    fg="white",
    activebackground="#ec971f",
    activeforeground="white",
    relief="flat",
    padx=20,
    pady=8
)
btn.pack(pady=12)

root.mainloop()

