msgstr "Abra un archivo .exe para continuar"

#: src/window.py:175
msgid "Exe Warn Notification"
msgstr "Notificación de Exe Warn"

#: src/window.py:176
msgid ""
"If the application did not open, it may have some package dependency or need "
"to be run as Administrator. Run via Terminal!"
msgstr ""
"Si la aplicación no se abrió, puede que tenga alguna dependencia de paquetes "
"o que deba ejecutarse como administrador. ¡Ejecútela desde la terminal!"

#: src/window.py:183
msgid "Execution Failure"
msgstr "Error de ejecución"

#: src/window.py:184
msgid "The file could not be executed. Run via Terminal!"
msgstr "No se pudo ejecutar el archivo. ¡Ejecútelo desde la terminal!"

#: src/window.py:206
msgid "this app"
msgstr "esta aplicación"

#: src/window.py:208
msgid "Add Application Repository?"
msgstr "¿Agregar repositorio de aplicaciones?"

#: src/window.py:209
#, python-brace-format
msgid ""
"To install {app_name}, the main Flathub application repository needs to be "
"added to your system."
msgstr ""
"Para instalar {app_name}, es necesario agregar el repositorio principal de "
"aplicaciones de Flathub a su sistema."

#: src/window.py:211
msgid "Cancel"
msgstr "Cancelar"

#: src/window.py:212
msgid "Add Repository"
msgstr "Agregar repositorio"

#: src/window.py:228
msgid "Repository Added"
msgstr "Repositorio agregado"

#: src/window.py:228
msgid ""
"The Flathub repository has been added. Please try the installation again."
msgstr ""
"El repositorio de Flathub se agregó. Intente realizar la instalación "
"nuevamente."

#: src/window.py:229
msgid "OK"
msgstr "Aceptar"

#: src/window.ui:6
msgid "Exe Warn"
msgstr "Exe Warn"

#: src/window.ui:53
#, python-brace-format
msgid ""
